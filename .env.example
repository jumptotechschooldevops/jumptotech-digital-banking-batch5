# Copy to .env and fill in local values. Never commit the real .env file.
# No value below is a real secret — this file documents variable names only.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/jumptotech_banking
DB_USERNAME=jumptotech_dev
DB_PASSWORD=changeme_local_only

# --- Spring profile ---
SPRING_PROFILES_ACTIVE=local

# --- Session / cookies ---
# Set to true only when served over HTTPS (staging/prod). Must be false for local http://localhost dev.
APP_SESSION_COOKIE_SECURE=false

# --- Demo / seed data (local and dev profiles only; refuses to run when SPRING_PROFILES_ACTIVE=prod) ---
SEED_DEMO_DATA=true
ADMIN_SEED_EMAIL=admin@example.local
ADMIN_SEED_PASSWORD=set_your_own_local_admin_password

# --- Frontend ---
VITE_API_BASE_URL=/api/v1
